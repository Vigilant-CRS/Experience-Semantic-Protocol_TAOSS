{
  "$defs": {
    "AffectScope": {
      "description": "What an affect statement is about (plan section 4.5, ADR-0008).\n\nV13 section 6.4: L1 EMO is content-side; subject-side inferred affect\nbelongs to L2+ and must never be confused with it on the same channel.",
      "enum": [
        "content",
        "self_declared",
        "inferred_subject",
        "machine_relay"
      ],
      "title": "AffectScope",
      "type": "string"
    },
    "ClaimType": {
      "enum": [
        "emotion_category",
        "affect_dimension",
        "action_readiness",
        "committed_intention",
        "context",
        "knowledge",
        "sensory",
        "temporal",
        "appraisal"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "ClockStamp": {
      "additionalProperties": false,
      "description": "A timestamp with explicit clock provenance.",
      "properties": {
        "clock_domain": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.:\\-]*$",
          "title": "Clock Domain",
          "type": "string"
        },
        "clock_offset_ns": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": -9223372036854775808,
          "title": "Clock Offset Ns",
          "type": "integer"
        },
        "monotonic_ns": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Monotonic Ns",
          "type": "integer"
        },
        "sequence": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "source_ns": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Source Ns",
          "type": "integer"
        },
        "uncertainty_ns": {
          "default": 0,
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Uncertainty Ns",
          "type": "integer"
        },
        "wall_clock_ns": {
          "anyOf": [
            {
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Clock Ns"
        }
      },
      "required": [
        "source_ns",
        "monotonic_ns",
        "clock_domain",
        "sequence"
      ],
      "title": "ClockStamp",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Who or what produced a statement, from which evidence.",
      "properties": {
        "model_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{16,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Digest"
        },
        "producer_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producer Id"
        },
        "producer_version": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z\\-]+(?:\\.[0-9A-Za-z\\-]+)*)?(?:\\+[0-9A-Za-z\\-]+(?:\\.[0-9A-Za-z\\-]+)*)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producer Version"
        },
        "source_kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "source_refs": {
          "default": [],
          "items": {
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "source_kind"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SourceKind": {
      "description": "Where a statement comes from (plan section 14). Never merged silently.",
      "enum": [
        "self_report",
        "human_annotation",
        "sensor_observation",
        "model_inference",
        "derived",
        "synthetic_ground_truth"
      ],
      "title": "SourceKind",
      "type": "string"
    }
  },
  "$id": "https://github.com/Vigilant-CRS/Experience-Semantic-Protocol_TAOSS/schemas/evidence_claim.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "affect_scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/AffectScope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "calibration_profile": {
      "anyOf": [
        {
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Calibration Profile"
    },
    "claim": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_\\-]*$",
      "title": "Claim",
      "type": "string"
    },
    "claim_type": {
      "$ref": "#/$defs/ClaimType"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "model_probability": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Probability"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "timestamp": {
      "$ref": "#/$defs/ClockStamp"
    },
    "value": {
      "maximum": 1.0,
      "minimum": -1.0,
      "title": "Value",
      "type": "number"
    }
  },
  "required": [
    "id",
    "claim_type",
    "claim",
    "value",
    "confidence",
    "provenance",
    "timestamp"
  ],
  "title": "EvidenceClaim",
  "type": "object"
}
